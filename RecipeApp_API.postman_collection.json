    {
      "name": "Recipes",
      "description": "Recipe management endpoints",
      "item": [
        {
          "name": "Get All Recipes",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/recipes",
              "host": ["{{base_url}}"],
              "path": ["api", "recipes"]
            }
          }
        },
        {
          "name": "Get Recipe by ID",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/recipes/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "recipes", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "recipe_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by Ingredient",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/recipes/ingredient/:ingredienteId",
              "host": ["{{base_url}}"],
              "path": ["api", "recipes", "ingredient", ":ingredienteId"],
              "variable": [
                {
                  "key": "ingredienteId",
                  "value": "ingredient_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by Excluding Ingredient",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/recipes/not-ingredient/:ingredienteId",
              "host": ["{{base_url}}"],
              "path": ["api", "recipes", "not-ingredient", ":ingredienteId"],
              "variable": [
                {
                  "key": "ingredienteId",
                  "value": "ingredient_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by Tags",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/recipes/tags?tags=tag1,tag2",
              "host": ["{{base_url}}"],
              "path": ["api", "recipes", "tags"],
              "query": [
                {
                  "key": "tags",
                  "value": "tag1,tag2"
                }
              ]
            }
          }
        },
        {
          "name": "Filter by User",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/recipes/user/:usuarioId",
