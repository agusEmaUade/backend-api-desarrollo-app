          "name": "Get Recipe Names",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/recipes/names",
              "host": ["{{base_url}}"],
              "path": ["api", "recipes", "names"]
            }
          }
        },
