            },
            "url": {
              "raw": "{{base_url}}/api/recipes/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "recipes", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "recipe_id_here"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Recipe",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/recipes/:id",
              "host": ["{{base_url}}"],
              "path": ["api", "recipes", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "recipe_id_here"
