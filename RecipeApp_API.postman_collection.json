          "name": "Get Ingredient Names",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/ingredients/names",
              "host": ["{{base_url}}"],
              "path": ["api", "ingredients", "names"]
            }
          }
        },
        {
          "name": "Create Recipe",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{access_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Nueva Receta\",\n  \"ingredientes\": [\n    {\n      \"nombre\": \"Ingrediente 1\",\n      \"cantidad\": 1,\n      \"unidad\": \"unidad\"\n    }\n  ],\n  \"pasos\": [\"Paso 1\", \"Paso 2\"],\n  \"tiempoPreparacion\": 30,\n  \"tiempoCoccion\": 45,\n  \"porciones\": 4,\n  \"dificultad\": \"medio\",\n  \"etiquetas\": [\"tag1\", \"tag2\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/recipes",
              "host": ["{{base_url}}"],
              "path": ["api", "recipes"]
            }
          }
        },
